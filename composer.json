{
  "name": "erdmannfreunde/sirius-theme-bundle",
  "type": "contao-bundle",
  "description": "Install SIRIUS Theme dependencies via Contao Manager or Composer",
  "keywords": [
    "contao theme",
    "contao",
    "theme",
    "sirius"
  ],
  "license": "LGPL-3.0-or-later",
  "authors": [
    {
      "name": "Dennis Erdmann",
      "homepage": "https://erdmann-freunde.de"
    }
  ],
  "require": {
    "php": "^8.1",
    "contao/core-bundle": "^5.7",
    "nutshell-framework/nutshell": "^2.0",
    "nutshell-framework/hero-element": "^1.2",
    "nutshell-framework/contact-element": "^1.0",
    "nutshell-framework/card-element": "^1.0",
    "erdmannfreunde/onepage-navigation": "^2.1",
    "erdmannfreunde/theme-toolbox": "^4.2",
    "erdmannfreunde/contao-grid-bundle": "^2.0",
    "erdmannfreunde/contao-ping-bundle": "^1.0"
  },
  "conflict": {
    "contao/core-bundle": "<5.0"
  },
  "autoload": {
    "psr-4": {
      "ErdmannFreunde\\SiriusThemeBundle\\": "src/"
    }
  },
  "extra": {
    "contao-manager-plugin": "ErdmannFreunde\\SiriusThemeBundle\\ContaoManager\\Plugin"
  }
}
